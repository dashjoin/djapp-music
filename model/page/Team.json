{
    "ID": "Team",
    "layout": {
        "widget": "page",
        "children": [
            {
                "widget": "diagram",
                "title": "Org chart",
                "size": 8,
                "edges": "$all('chinook', 'Employee')[ReportsTo].{'source': ReportsTo, 'target': EmployeeId}",
                "nodes-pointer": "org-chart.jsonata"
            },
            {
                "widget": "chart",
                "title": "Revenue per sales rep",
                "size": 4,
                "chart": "doughnut",
                "database": "chinook",
                "query": "revenue-by-rep",
                "arguments": "{}",
                "style": {
                    "scales.x.display": "false",
                    "scales.y.display": "false"
                }
            },
            {
                "widget": "expansion",
                "text": "Explore relationships as a graph",
                "children": [
                    {
                        "widget": "graph",
                        "nodes": "$all('chinook', 'Employee').EmployeeId.{'database': 'chinook', 'table': 'Employee', 'pk': [$]}"
                    }
                ]
            }
        ]
    }
}